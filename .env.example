# ============================================================================
# Environment Configuration Template
# ============================================================================

# Database URL (PostgreSQL / Neon / Oracle)
DATABASE_URL=postgresql+psycopg2://user:password@host/dbname?sslmode=require

# Backend & Server Settings
PROJECT_NAME="Road Hazard Robot Cloud Backend"
API_V1_STR="/api"
PORT=8000
HOST=0.0.0.0
DEBUG=True
SECRET_KEY="your-jwt-secret-key-here"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Robot Auth Security
ROBOT_API_KEY="your-robot-api-key-here"

# Severity & Alert Thresholds
ALERT_SEVERITY_THRESHOLD=75.0
ALERT_RATE_LIMIT_MINUTES=15

# MQTT Broker Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=backend-subscriber
MQTT_HAZARD_TOPIC=roadbot/+/hazards
MQTT_HEARTBEAT_TOPIC=roadbot/+/heartbeat
